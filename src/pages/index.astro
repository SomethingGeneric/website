---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { promises as fs } from "fs";
import path from "path";

const filePath = path.join(process.cwd(), "src/data/ai-responses.md");
const fileContents = await fs.readFile(filePath, "utf8");
const responses = fileContents.split("\n").filter(Boolean); // filter(Boolean) removes empty lines
const randomResponse = responses[Math.floor(Math.random() * responses.length)];

const blogModules = Object.values(import.meta.glob("./blog/*.md", { eager: true }));

const postsWithDates = blogModules
  .map((post) => {
    const url = post.url;
    const filename = post.file?.split("/").pop() ?? (url ? url.split("/").pop()?.replace(".html", ".md") : null);
    const dateFromFrontmatter = post.frontmatter?.date ?? post.frontmatter?.pubDate;
    const dateMatch = !dateFromFrontmatter && filename ? filename.match(/^(\d{4}-\d{2}-\d{2})/) : null;
    const dateString = dateFromFrontmatter ?? dateMatch?.[1] ?? null;
    const date = dateString ? new Date(dateString) : null;

    return {
      title: post.frontmatter?.title ?? filename?.replace(".md", "") ?? "Untitled post",
      url,
      date,
      displayDate: date
        ? date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
        : null,
    };
  })
  .filter((post) => post.url && post.date);

const latestPost = postsWithDates
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0))
  .at(0) ?? null;
---

<Layout>
	<Navbar />
	<main>
		<h1>Matt C</h1>
		<p>✨{randomResponse}✨</p>

		<h2 style="color:yellow;">Support right to repair, be a Clippy!</h2>
		<a href="https://www.youtube.com/watch?v=2_Dtmpe9qaQ"><img src="/images/clippy.jpg" style="height: 200px;" alt="Change your profile picture to clippy in order to support the right to repair movement."/></a>
		<p>Louis Rossman's <a href="https://www.youtube.com/watch?v=2_Dtmpe9qaQ">video</a> on the Clippy movement.</p>

		{latestPost && (
		<section>
			<h2>Latest Blog Post</h2>
			<h4 class="latest-post__title">
				<a href={latestPost.url}>{latestPost.title}</a>
			</h3>
			{latestPost.displayDate && (
				<p class="latest-post__meta">Published {latestPost.displayDate}</p>
			)}
		</section>
		<br/>
		)}

		<h2>Stuff I've Done</h2>
		<ul>
			<li>
				<s><a href="https://getcryst.al">Crystal Linux</a></s>, an Archlinux based distribution
			</li>
			<li><a href="https://goober.cloud">Goober.Cloud</a></li>
			<!--<li>
				Discord.py bot <a
					href="https://github.com/SomethingGeneric/GamerbotAgain/"
					>Gamerbot</a>
			</li>-->
			<li>
				Many others on my <a href="https://github.com/SomethingGeneric"
					>GitHub</a
				> or my <a href="https://gitlab.goober.cloud/matt"
					>GitLab Instance</a>
			</li>
		</ul>
		<h2>Where else am I?</h2>
		<ul>
			<li>
				<a href="https://www.linkedin.com/in/matt-compton-a06243220"
					>LinkedIn</a>
			</li>
			<li>
				<a
					href="https://docs.google.com/document/d/1DnYIzam28i1XA539HbV1L0TYgKv_BUmVXJM7WnJIEUk/edit?usp=sharingg"
					>Resume</a>
			</li>
			<li>
				<a href="https://gitlab.goober.cloud/matt">My GitLab (personal git server)</a>
			</li>
			<li><a href="https://github.com/SomethingGeneric">GitHub</a></li>
			<li>
				<a
					href="https://www.cybertechvt.com/index.php/2023/04/27/vaultwarden/"
					>Blog Posts for CyberTechVT</a>
			</li>
		</ul>
		<h2>Technology-related Events</h2>
		<ul>
			<li>
				Captain of, and Competed on the Champlain College <a
					href="https://www.nationalccdc.org/">CCDC</a
				> Team at the <a href="https://neccdl.org/">NECCDC</a> Regionals
			</li>
			<li>
				Competed in the <a href="https://ncaecybergames.org/"
					>NCAE Cyber Games</a
				> online event, and National Invitational
			</li>
			<li>One Hackathon at Montgomery Blair HS</li>
			<li>
				Two <a href="https://www.congressionalappchallenge.us/"
					>Congressional App Challenges</a>
			</li>
			<li>Cybersecurity challenge sponsored by Montgomery College</li>
		</ul>
		<br/>
	</main>
	<style>
		.latest-post {
			margin-top: 2rem;
			padding: 1rem;
			border: 2px solid #fff;
		}

		.latest-post__title {
			margin-top: 0.25rem;
		}

		.latest-post__meta {
			margin: 0.5rem 0 0;
		}
	</style>
</Layout>
