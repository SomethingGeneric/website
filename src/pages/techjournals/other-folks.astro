<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 6, 7, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 1000;
    backdrop-filter: blur(2px);
  }

  .modal-content {
    width: min(540px, 100%);
    border: 2px solid var(--border);
    background: var(--bg-panel);
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.6), inset 0 0 18px rgba(0, 0, 0, 0.7);
    padding: 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .modal-content::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, transparent 70%, rgba(0, 0, 0, 0.35) 70%);
    background-size: 100% 4px;
    opacity: 0.25;
    pointer-events: none;
  }

  .modal-content > * {
    position: relative;
    z-index: 1;
  }

  .modal-content--narrow {
    width: min(420px, 100%);
  }

  .modal-content h2 {
    margin: 0 0 12px;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .modal-content p {
    margin: 0 0 16px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 16px;
  }

  .modal-actions--form {
    justify-content: flex-end;
  }

  .modal-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 24px;
    min-height: 44px;
    border-radius: 4px;
    letter-spacing: 0.1em;
  }

  .modal-button--outline {
    background: transparent;
    border: 2px dashed var(--accent);
    color: var(--accent);
  }

  .modal-button--outline:hover,
  .modal-button--outline:focus-visible {
    background: var(--accent);
    color: var(--bg-primary);
  }

  .modal-button--wide {
    width: min(320px, 100%);
    display: block;
    margin: 0 auto 16px;
  }

  .modal-button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .modal-form {
    display: grid;
    gap: 16px;
    text-align: left;
  }

  .modal-form label {
    color: var(--accent);
  }

  .grad-year {
    display: grid;
    gap: 8px;
  }

  .status-message {
    min-height: 1.5rem;
    margin-top: 16px;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .status-success {
    color: var(--accent);
  }

  .status-error {
    color: var(--error);
  }

  #main-content h2 {
    margin-top: 32px;
  }

  table {
    margin: 24px 0;
    width: 100%;
    border-collapse: collapse;
    border: 2px solid var(--border);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  thead th {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(0, 0, 0, 0.45);
  }

  th,
  td {
    border: 1px solid var(--border);
    padding: 10px 12px;
    vertical-align: top;
  }

  td {
    color: var(--text-muted);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  th {
    color: inherit;
    text-align: left;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
  }

  tbody tr:hover {
    background: rgba(255, 170, 0, 0.08);
  }

  td a {
    word-break: break-word;
  }

  .courses-collapse {
    display: block;
  }

  .courses-collapse summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .courses-collapse summary::-webkit-details-marker {
    color: var(--accent);
  }

  .courses-collapse[open] summary {
    margin-bottom: 8px;
  }

  .courses-list {
    margin: 8px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 4px;
  }

  .courses-collapse summary + .courses-list {
    margin-top: 12px;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 600px) {
    .modal-content {
      padding: 20px;
    }

    .modal-actions--form {
      justify-content: center;
    }
  }
</style>

<script
  type="application/json"
  id="techjournal-config"
  set:html={JSON.stringify(submissionConfig)}
></script>

<script type="module" src="/scripts/techjournal-submission.js"></script>
<script type="module" src="/scripts/collapse-course-codes.js"></script>
