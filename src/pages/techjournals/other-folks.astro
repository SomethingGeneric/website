---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

const proxyBase = (import.meta.env.PUBLIC_TECHJOURNAL_PROXY_BASE ?? '').trim().replace(/\/$/, '');

const submissionConfig = {
  enabled: Boolean(proxyBase),
  proxyBase
};
---

<Layout>
  <Navbar />
  <main>
    <h1>Tech Journals from Other Folks</h1>
    
    <!-- Modal overlay and content -->
    <div
      id="acknowledgement-modal"
      class="modal-overlay"
      role="dialog"
      aria-modal="true"
      aria-labelledby="acknowledgement-title"
    >
      <div class="modal-content">
        <h2 id="acknowledgement-title">Acknowledgement</h2>
        <p>By accessing this page, you understand that being listed on this page is the "price" of using and sharing these tech journal links.</p>
        <p>All individuals listed here have shared their work publicly and are acknowledged for their contributions to the community.</p>
        <div class="modal-actions">
          <button id="accept-button" class="modal-button">I Understand</button>
          <button id="add-me-btn" class="modal-button modal-button--outline">Add Me to the List</button>
        </div>
      </div>
    </div>

    <!-- Main content (hidden by default until modal is dismissed) -->
    <div id="main-content" class="hidden" aria-hidden="true">
      <h2>GitHub Pages from other Champlain Cyber/DF folks:</h2>
      <!-- Add Techjournal Button -->
      <button id="add-techjournal-btn" class="modal-button modal-button--wide modal-button--outline">Add Your Techjournal</button>

      <!-- Modal for submitting techjournal info -->
      <div
        id="techjournal-modal"
        class="modal-overlay hidden"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-labelledby="techjournal-title"
      >
        <div class="modal-content modal-content--narrow">
          <h2 id="techjournal-title">Submit Your Techjournal</h2>
          <form id="techjournal-form" class="modal-form">
            <label for="name-input">My Name</label>
            <input type="text" id="name-input" name="name" required>
            <label for="link-input">My Techjournal Link</label>
            <input type="url" id="link-input" name="link" required>
            <label for="role-select">I am a</label>
            <select id="role-select" name="role" required>
              <option value="" disabled selected>Choose one</option>
              <option value="student">Student</option>
              <option value="staff">Staff</option>
            </select>
            <div id="grad-year-group" class="grad-year hidden">
              <label for="grad-year-input">Graduation Year</label>
              <input type="number" id="grad-year-input" name="gradYear" min="1900" max="2200" inputmode="numeric" pattern="[0-9]{4}">
            </div>
            <div class="modal-actions modal-actions--form">
              <button type="submit" class="modal-button">Submit</button>
              <button type="button" id="cancel-techjournal" class="modal-button modal-button--outline">Cancel</button>
            </div>
          </form>
          <p id="techjournal-status" class="status-message" role="status" aria-live="polite"></p>
        </div>
      </div>
      
      <table>
