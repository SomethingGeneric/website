---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
  <Navbar />
  <section>
    <h1>Linux (and Unix!) Stuff</h1>
    <p id="linux-tenure">I've been a linux user for a while now.</p>
    <p>(Also take a look at my homelab docs (which I really need to update....))</p>
    <p>
      I was <s>I'm</s> a founding core team member and repository maintainer for
      <a href="https://web.archive.org/web/20240603050511/https://getcryst.al/site">Crystal Linux</a>
    </p>
    <p>I use Arch <s>Crystal</s> on my laptop and desktop machines.</p>
    <p>
      I mostly run Debian (or Proxmox (based on Debian)) on my servers. (And this web server is FreeBSD!)
    </p>
    <p>There's plenty of Linux/Arch <s>/Crystal</s> stuff on my GitHub!</p>
    <!-- <p aria-hidden="true">
      <br />
      <br />
      <br />
      <br />
      <br />
    </p> -->
    <p class="logo-wrap logo-row">
      <a target="_blank" href="https://www.freebsd.org/">
        <img src="/images/fbsd-banner1.gif" alt="FreeBSD Banner" data-banner />
      </a>
      <a href="https://freebsdfoundation.org/donate" target="_blank">
        <img src="https://freebsdfoundation.org/wp-content/uploads/2015/12/proud_donor.gif" alt="Proud Donor" title="FreeBSD Foundation Donor" data-donor/>
      </a>
    </p>
    <p class="logo-wrap">
	    <a target="_blank" href="https://archlinux.org/">
	      <img src="/images/archlinux-logo-light-90dpi.png" alt="Arch Linux Logo" data-lock-logo/>
	    </a>
    </p>
    <p class="logo-wrap">
	    <a target="_blank" href="https://debian.org/">
	      <img src="/images/debianbutton.jpg" alt="Debian Linux Logo" data-lock-logo/>
	    </a>
    </p>
    <p class="logo-wrap">
		<a target="_blank" href="https://my.fsf.org/join">
			      <img src="/images/FSF40-logo.png" alt="Free Software Foundation 40th Anniversary" data-lock-logo/>
	    </a>
    </p>
  </section>
  <script>
    const tenureElement = document.getElementById('linux-tenure');
    const linuxStartDate = new Date(Date.UTC(2020, 3, 25)); // April 25, 2020 in UTC

    const formatPart = (value, label) => `${value} ${label}${value === 1 ? '' : 's'}`;

    const calculateElapsed = (start, now) => {
      let years = now.getUTCFullYear() - start.getUTCFullYear();
      let months = now.getUTCMonth() - start.getUTCMonth();
      let days = now.getUTCDate() - start.getUTCDate();

      if (days < 0) {
        const previousMonth = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 0));
        days += previousMonth.getUTCDate();
        months -= 1;
      }

      if (months < 0) {
        months += 12;
        years -= 1;
      }

      return { years, months, days };
    };

    const updateTenure = () => {
      if (!tenureElement) return;
      const { years, months, days } = calculateElapsed(linuxStartDate, new Date());
      tenureElement.textContent = `I've been a linux user for ${formatPart(years, 'year')}, ${formatPart(
        months,
        'month'
      )}, and ${formatPart(days, 'day')}.`;
    };

    updateTenure();
    setInterval(updateTenure, 60 * 60 * 1000);

    const bannerImage = document.querySelector('[data-banner]');
    const lockImages = document.querySelectorAll('[data-lock-logo]');
    const donorImage = document.querySelector('[data-donor]');

    const applyBannerWidth = () => {
      if (!bannerImage) return;
      const width = bannerImage.naturalWidth || bannerImage.getBoundingClientRect().width;
      if (!width) return;
      const targetWidth = Math.round(width);

      const setDimensions = (img) => {
        img.style.width = '100%';
        img.style.maxWidth = `${targetWidth}px`;
        img.style.height = 'auto';
        img.style.display = 'block';
      };

      setDimensions(bannerImage);
      lockImages.forEach(setDimensions);

      if (donorImage) {
        const donorHeight = donorImage.naturalHeight || donorImage.getBoundingClientRect().height;
        if (!donorHeight) return;
        donorImage.style.display = 'block';
        donorImage.style.margin = '0';
        donorImage.style.width = 'auto';
        donorImage.style.maxWidth = `${targetWidth}px`;
        donorImage.style.height = `${Math.round(donorHeight / 2)}px`;
      }
    };

    if (bannerImage) {
      if (bannerImage.complete) {
        applyBannerWidth();
      } else {
        bannerImage.addEventListener('load', applyBannerWidth, { once: true });
      }
      window.addEventListener('resize', applyBannerWidth);
    }

    if (donorImage && !donorImage.complete) {
      donorImage.addEventListener('load', applyBannerWidth, { once: true });
    }
  </script>
  <style>
    .logo-wrap {
      text-align: center;
    }

    .logo-wrap img {
      display: block;
      margin: 0 auto;
    }

    .logo-row {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .logo-row img {
      margin: 0;
    }
  </style>
</Layout>
