---
import '../styles/global.css';
import SearchPalette from '../components/SearchPalette.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { themeAliases, themeOptions, themeStorageKey } from '../data/themes';
import alprStatesRaw from '../data/alpr-states.txt?raw';

const currentYear = new Date().getFullYear();
const buildDate = new Date().toLocaleString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: 'America/New_York'
});

const fallbackTheme = themeOptions[0]?.id ?? 'terminal';
const envTheme = import.meta.env.PUBLIC_DEFAULT_THEME;
const defaultTheme = themeOptions.some((theme) => theme.id === envTheme) ? envTheme : fallbackTheme;
const themeIdsLiteral = JSON.stringify(themeOptions.map((theme) => theme.id));
const defaultThemeLiteral = JSON.stringify(defaultTheme);
const storageKeyLiteral = JSON.stringify(themeStorageKey);
const themeAliasesLiteral = JSON.stringify(themeAliases);
const inlineThemeScript = `(function () {
	var themeIds = ${themeIdsLiteral};
	var defaultTheme = ${defaultThemeLiteral};
	var storageKey = ${storageKeyLiteral};
	var themeAliases = ${themeAliasesLiteral};

	if (!Array.isArray(themeIds) || themeIds.length === 0) {
		return;
	}

	if (themeIds.indexOf(defaultTheme) === -1) {
		defaultTheme = themeIds[0];
	}

	var storedTheme = null;
	try {
		storedTheme = localStorage.getItem(storageKey);
		if (storedTheme && !themeIds.includes(storedTheme) && themeAliases && themeAliases[storedTheme]) {
			storedTheme = themeAliases[storedTheme];
		}
	} catch (error) {
		storedTheme = null;
	}

	var initialTheme = storedTheme && themeIds.indexOf(storedTheme) !== -1 ? storedTheme : defaultTheme;
	if (initialTheme) {
		document.documentElement.dataset.theme = initialTheme;
	}
})();`;

const stateCodeMap = {
  alabama: 'AL',
  alaska: 'AK',
  arizona: 'AZ',
  arkansas: 'AR',
  california: 'CA',
  colorado: 'CO',
  connecticut: 'CT',
  delaware: 'DE',
  florida: 'FL',
  georgia: 'GA',
  hawaii: 'HI',
  idaho: 'ID',
  illinois: 'IL',
  indiana: 'IN',
  iowa: 'IA',
  kansas: 'KS',
  kentucky: 'KY',
  louisiana: 'LA',
  maine: 'ME',
  maryland: 'MD',
  massachusetts: 'MA',
  michigan: 'MI',
  minnesota: 'MN',
  mississippi: 'MS',
  missouri: 'MO',
  montana: 'MT',
  nebraska: 'NE',
  nevada: 'NV',
  'new hampshire': 'NH',
  'new jersey': 'NJ',
  'new mexico': 'NM',
  'new york': 'NY',
  'north carolina': 'NC',
  'north dakota': 'ND',
  ohio: 'OH',
  oklahoma: 'OK',
  oregon: 'OR',
  pennsylvania: 'PA',
  'rhode island': 'RI',
  'south carolina': 'SC',
  'south dakota': 'SD',
  tennessee: 'TN',
  texas: 'TX',
  utah: 'UT',
  vermont: 'VT',
  virginia: 'VA',
  washington: 'WA',
  'west virginia': 'WV',
  wisconsin: 'WI',
  wyoming: 'WY',
  'district of columbia': 'DC'
};

const normalizeStateCode = (input) => {
  if (!input) {
    return null;
  }
  const trimmed = input.trim();
  if (!trimmed) {
    return null;
  }
  const upper = trimmed.toUpperCase();
  if (upper.length === 2) {
    return upper;
  }
  const key = trimmed.toLowerCase();
  return stateCodeMap[key] ?? null;
};

const alprStateCodes = alprStatesRaw
  .split(/\r?\n/)
  .map((line) => line.split('#')[0].trim())
  .filter(Boolean)
  .map(normalizeStateCode)
  .filter(Boolean);

const alprStateCodesLiteral = JSON.stringify(alprStateCodes);
const envGeoipUrl = import.meta.env.PUBLIC_GEOIP_URL;
const geoipUrlLiteral = JSON.stringify(envGeoipUrl && envGeoipUrl.trim() ? envGeoipUrl : 'https://ipapi.co/json/');
---
<!DOCTYPE html>
<html lang="en" data-theme={defaultTheme}>
		<head>
			<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>matt c</title>
		<link rel="icon" href="/images/siseor.jpg" />
			<script is:inline set:html={inlineThemeScript}></script>
		</head>
	<body>
		<div class="crt-wrapper">
			<div class="console">
				<SearchPalette />
				<header>
					<span class="header-title">matt c</span>
					<span class="header-tip">tip: search with ctrl/cmd + shift + space</span>
					<div class="status-wrapper">
						<span class="status" data-status-indicator>
							<span class="status-prefix">sys/</span>
							<span class="status-value" data-status-value>online</span>
						</span>
						<ThemeToggle themes={themeOptions} defaultTheme={defaultTheme} variant="hidden" />
					</div>
				</header>
				<div class="console-content">
					<slot />
				</div>
				<!-- Hi there! If you're reading this, don't be alarmed. The below script is NAMED to look like an ads-hook, so that you won't see the 
				popup content if you actually HAVE an adblocker.-->
				<script defer src="/scripts/nativeads.js"></script>
				<script defer src="/scripts/alpr-warning.js"></script>

				<!-- Umami analytics -->
				<script defer src="https://umami.mattcompton.dev/script.js" data-website-id="7b10f775-3ad8-45fd-9641-888ad99cac3f"></script>

				<div
				id="ad-note-hidden"
				class="ftf-dma-note ad native-ad native-ad-1 ytd-j yxd-j yxd-jd aff-content-col aff-inner-col aff-item-list ark-ad-message inplayer-ad inplayer_banners in_stream_banner trafficjunky-float-right dbanner preroll-blocker happy-inside-player blocker-notice blocker-overlay exo-horizontal ave-pl bottom-hor-block brs-block advboxemb wgAdBlockMessage glx-watermark-container overlay-advertising-new header-menu-bottom-ads rkads mdp-deblocker-wrapper amp-ad-inner imggif bloc-pub bloc-pub2 hor_banner aan_fake aan_fake__video-units rps_player_ads fints-block__row full-ave-pl full-bns-block vertbars video-brs player-bns-block wps-player__happy-inside gallery-bns-bl stream-item-widget adsbyrunactive happy-under-player adde_modal_detector adde_modal-overlay ninja-recommend-block aoa_overlay message"
				>
				<p id="ad-note-content-wrapper">
				</p>
				</div>

				<div
				id="alpr-note-hidden"
				data-alpr-states={alprStateCodesLiteral}
				data-geoip-url={geoipUrlLiteral}
				data-privacy-link="/techopinions/privacy"
				class="alpr-note"
				role="dialog"
				aria-modal="true"
				aria-hidden="true"
				>
					<div class="alpr-note__panel">
						<p class="alpr-note__eyebrow">captcha required</p>
						<img class="alpr-note__image" src="/images/clippy.jpg" alt="Clippy" width="220" height="220" loading="lazy" />
						<p class="alpr-note__message">
							Hi, clippy sees that you live in <span id="alpr-state-label">your state</span> and your state is
							uncomfortably friendly to ALPR, which damages your privacy.
							<a id="alpr-privacy-link" href="/techopinions/privacy">Read more</a>.
						</p>
						<button type="button" id="alpr-close-button" class="alpr-note__button">I Understand</button>
					</div>
				</div>
				<footer>
					<p>please contact me if you notice anything missing or broken on this site</p>
					<p>site last built at {buildDate}</p>
					<!--<p>or just make an issue/PR on <a href="https://gitlab.goober.cloud/matt/website/-/issues/new?type=ISSUE">the source repo</a></p>-->
					<p>Please view the <a href="/policy">site policy.</a></p>
					<p>copyright matt c {currentYear}</p>
						<div class="badge-row">
							<a href="https://freebsd.org"><img src="/images/power-button.gif" alt="FreeBSD badge" width="88" height="31" /></a>
							<a href="https://www.defectivebydesign.org/"><img src="/images/dbd.gif" alt="DRM badge" width="88" height="31" /></a>
							<a href="https://firefox.com"><img src="/images/firefox4.gif" alt="Firefox badge" width="88" height="31" /></a>
						</div>
				</footer>
			</div>
		</div>
	</body>
</html>
